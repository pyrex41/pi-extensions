{
  "name": "@pyrex41/pi-extensions",
  "version": "0.3.0",
  "description": "Pi extensions for SCUD, Shen-Backpressure, model-independent advisory workflows and cheap background progress observation",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/pyrex41/pi-extensions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyrex41/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/pyrex41/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "scud",
    "shen-backpressure",
    "todo",
    "multi-agent",
    "background-observer"
  ],
  "pi": {
    "extensions": [
      "./extensions/scud/index.ts",
      "./extensions/shen-backpressure/index.ts",
      "./extensions/workflows/index.ts",
      "./extensions/observer/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.20.2",
    "typebox": "^1.3.30",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  }
}
